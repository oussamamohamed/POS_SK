{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateTableRequest",
  "type": "object",
  "required": [
    "tableNumber"
  ],
  "properties": {
    "tableNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Identifiant ou dénomination de la table (ex: 'T9', 'Terrasse 1')"
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 4,
      "description": "Nombre maximal de places assises"
    },
    "positionX": {
      "type": "number",
      "default": 0,
      "description": "Coordonnée X d'affichage sur le plan de salle"
    },
    "positionY": {
      "type": "number",
      "default": 0,
      "description": "Coordonnée Y d'affichage sur le plan de salle"
    }
  }
}
