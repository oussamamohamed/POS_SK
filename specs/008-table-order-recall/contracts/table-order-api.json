{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActiveTableOrderResponse",
  "type": "object",
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "tableNumber": { "type": "string" },
    "waiterName": { "type": "string" },
    "coversCount": { "type": "integer", "minimum": 1 },
    "openedAtUtc": { "type": "string", "format": "date-time" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineId": { "type": "string", "format": "uuid" },
          "productId": { "type": "string", "format": "uuid" },
          "productName": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number" },
          "totalPrice": { "type": "number" },
          "taxRatePercent": { "type": "number" },
          "preparationStationId": { "type": ["string", "null"] },
          "isDispatched": { "type": "boolean" },
          "modifiersSummary": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["lineId", "productId", "productName", "quantity", "unitPrice", "totalPrice", "taxRatePercent", "isDispatched"]
      }
    },
    "totalHtAmount": { "type": "number" },
    "totalVatAmount": { "type": "number" },
    "totalTtcAmount": { "type": "number" }
  },
  "required": ["orderId", "tableNumber", "coversCount", "lines", "totalHtAmount", "totalVatAmount", "totalTtcAmount"]
}
