<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RestaurantPos.Api</RootNamespace>
    <AssemblyName>RestaurantPos.Api</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RestaurantPos.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestaurantPos.Domain\RestaurantPos.Domain.csproj" />
    <ProjectReference Include="..\RestaurantPos.Application\RestaurantPos.Application.csproj" />
    <ProjectReference Include="..\RestaurantPos.Infrastructure\RestaurantPos.Infrastructure.csproj" />
  </ItemGroup>
</Project>
