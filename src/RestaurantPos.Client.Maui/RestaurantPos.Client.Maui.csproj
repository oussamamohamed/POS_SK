<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(BuildingForMaui)' == 'true' And '$(OS)' == 'Windows_NT'">net9.0-android;net9.0-ios;net9.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildingForMaui)' == 'true' And '$(OS)' != 'Windows_NT'">net9.0-android;net9.0-ios</TargetFrameworks>
    <TargetFramework Condition="'$(BuildingForMaui)' != 'true'">net9.0</TargetFramework>
    <OutputType Condition="'$(BuildingForMaui)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(BuildingForMaui)' != 'true'">Library</OutputType>
    <RootNamespace>RestaurantPos.Client.Maui</RootNamespace>
    <UseMaui Condition="'$(BuildingForMaui)' == 'true'">true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CA1311;CA1304;CA1305;CA1031;CA2007;CA1822;CA1852;CA1861;CA1825;CA1001;CA1859;CA1812;CA1823;CA1805</NoWarn>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <UseInterpreter Condition="$(TargetFramework.Contains('-ios'))">true</UseInterpreter>
    <MtouchUseLlvm Condition="$(TargetFramework.Contains('-ios'))">false</MtouchUseLlvm>
    <MtouchLink Condition="$(TargetFramework.Contains('-ios'))">None</MtouchLink>
    <XSAppIconAssets Condition="$(TargetFramework.Contains('-ios'))">Platforms/iOS/Assets.xcassets/AppIcon.appiconset</XSAppIconAssets>
  </PropertyGroup>

  <!-- Define MAUI_UI symbol when building with MAUI SDK so Views can use conditional compilation -->
  <PropertyGroup Condition="'$(UseMaui)' == 'true'">
    <DefineConstants>$(DefineConstants);MAUI_UI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseMaui)' == 'true'">
    <Using Include="RestaurantPos.Client.Maui.Contracts.HapticFeedbackType" Alias="HapticFeedbackType" />
    <BundleResource Include="Platforms/iOS/AppIcon*.png" Link="%(Filename)%(Extension)" Condition="$(TargetFramework.Contains('-ios'))" />
    <BundleResource Include="Platforms/iOS/iTunesArtwork*.png" Link="%(Filename)%(Extension)" Condition="$(TargetFramework.Contains('-ios'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseMaui)' != 'true'">
    <Compile Remove="Platforms\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestaurantPos.Domain\RestaurantPos.Domain.csproj" />
    <ProjectReference Include="..\RestaurantPos.Application\RestaurantPos.Application.csproj" />
  </ItemGroup>

  <Target Name="CleanExtendedAttributes" BeforeTargets="_CodesignAppBundle;_CodesignFrameworks">
    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;" Condition="Exists('$(AppBundleDir)')" IgnoreExitCode="true" />
  </Target>
</Project>
