# Fins de ligne : le dépôt stocke tout en LF ; la copie de travail suit la
# convention de chaque écosystème (.editorconfig) quel que soit l'OS.
* text=auto

# .NET, web, documentation, scripts PowerShell : CRLF (convention du projet)
*.cs            text eol=crlf
*.csproj        text eol=crlf
*.props         text eol=crlf
*.targets       text eol=crlf
*.sln           text eol=crlf
*.slnx          text eol=crlf
*.ps1           text eol=crlf
*.appxmanifest  text eol=crlf

# App iPad (Swift/Xcode), scripts shell, CI : LF obligatoire
*.swift         text eol=lf
*.sh            text eol=lf
*.pbxproj       text eol=lf
*.xcscheme      text eol=lf
*.xcworkspacedata text eol=lf
*.plist         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
ios/**          text=auto eol=lf

# Binaires
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.db            binary
*.xcresult      binary
