    "fiscal.x_z_explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقرير X معاينة مباشرة غير مختومة. إقفال Z يختم اليوم بتسلسل SHA-256 ويعيد العدادات إلى الصفر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X report is a live, unsealed preview. The Z closure seals the day with SHA-256 chaining and resets the counters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport X est un aperçu en direct, non scellé. La clôture Z scelle la journée par chaînage SHA-256 et remet les compteurs à zéro."
          }
        }
      }
    },
